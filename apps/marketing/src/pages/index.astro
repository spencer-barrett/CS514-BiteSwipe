---
import { Field, FieldGroup, FieldLabel } from "@/components/ui/field";
import Layout from "../layouts/Layout.astro";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";

---
<script src="../scripts/interest-form.ts"></script>
<!-- TODO: Consolidate styling where needed. Right now vanilla CSS is being mixed with tailwindCSS -->
<Layout>
  <main class="hero">
    <div class="overlay"></div>
    <div class="content gap-6">
      <div>
        <h1>
          Bite<span>Swipe</span>
        </h1>
        <h2 class="uppercase">Coming Soon</h2>
      </div>

      <form id="interest-form">
        <div class="flex w-100">
          <FieldGroup>
            <Field>
              <FieldLabel>Be first to join!</FieldLabel>
              <Input
                type="email"
                placeholder="email"
                name="email"
                className="text-white!"
              />
              <div class="w-full mt-4">
                <Button className="w-1/2 bg-[#ee2f36]" type="submit"
                  >Submit</Button
                >
              </div>
            </Field>
          </FieldGroup>
        </div>
      </form>
    </div>
  </main>
</Layout>

